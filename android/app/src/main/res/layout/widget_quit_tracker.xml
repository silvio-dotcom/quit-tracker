<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/pressstart2p"
            android:text="QUIT"
            android:textColor="#86efac"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1c242d"
            android:fontFamily="@font/pressstart2p"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:textColor="#22c55e"
            android:textSize="6sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/pressstart2p"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/widget_empty"
        android:textColor="#94a3b8"
        android:textSize="7sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/widget_smoke_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pressstart2p"
            android:text="SMOKE-FREE"
            android:textColor="#64748b"
            android:textSize="6sp" />

        <TextView
            android:id="@+id/widget_smoke_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/pressstart2p"
            android:maxLines="2"
            android:textColor="#f3f6f9"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_money"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/pressstart2p"
            android:maxLines="1"
            android:textColor="#22c55e"
            android:textSize="8sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_coin"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_coin_inner" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_chip_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pressstart2p"
                    android:maxLines="2"
                    android:textColor="#e2e8f0"
                    android:textSize="7sp" />

                <TextView
                    android:id="@+id/widget_chip_eta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/pressstart2p"
                    android:textColor="#86efac"
                    android:textSize="6sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
